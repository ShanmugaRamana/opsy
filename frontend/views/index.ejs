<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles/style.css">
</head>
<body>
    <aside class="sidebar">
        <header class="sidebar-header">
            <h1 class="title">Opsy</h1>
        </header>
    </aside>

    <main class="main-content">
        <div class="chat-wrapper">
            <div class="chat-input-container">
                <input type="text" id="chat-input" placeholder="Message Opsy..." autofocus>
                <button id="send-btn" class="send-btn">
                    <img src="/assets/icons/send.png" alt="Send" class="send-icon">
                </button>
            </div>
        </div>
    </main>
</body>
</html>
